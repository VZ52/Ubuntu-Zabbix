# Шаблон переменных окружения.
# Скопируй в .env и подставь свои значения. Сам .env в git не коммитится.

# --- PostgreSQL ---
POSTGRES_DB=zabbix
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=change_me_to_something_long_and_random

# --- Telegram бот (для алертинга) ---
# Получить токен у @BotFather, chat_id — у @userinfobot или через getUpdates API
TELEGRAM_BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789
